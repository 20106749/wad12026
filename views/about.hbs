{{> menu id="about"}}

<section class="ui left aligned middle aligned segment">
  
    <h2>About the Modlist app</h2>
      <p>
        I've chosen mods as i was looking at Minecraft mods as an example for Java programming in my other classes.
      </p>


<div class="ui centered card">
  <div class="image">
    <img src="{{devs.image}}">
  </div>
  <div class="content">
    <a class="header">{{devs.fullname}}</a>
    <div class="meta">
      <span class="date">Joined in {{devs.joined}}</span>
    </div>
    <div class="description">
      {{devs.name}} is an unorganised {{devs.job}} living in the {{devs.city}} area.
    </div>
  </div>
  <div class="extra content">
    <a>
      <i class="user icon"></i>
      {{devs.mates}} contacts
    </a>
  </div>
</div>

</section>
