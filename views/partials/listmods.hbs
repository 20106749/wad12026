{{#if mods}}

  <table class="ui unstackable striped table">
    <thead>
      <tr>
        <th>Mod (Total: {{mods.length}})</th>
        <th>Creator</th>
      </tr>
    </thead>
    <tbody>
      {{#each mods}}
        <tr>
          <td>
            {{title}}
          </td>
          <td>
            {{creator}}
          </td>
          <td class="center aligned">
            <a href="/modlist/{{../id}}/deletemod/{{id}}" title="Delete mod">
              <i class="ui black trash icon"></i>
            </a>
          </td>
        </tr>
      {{/each}}
    </tbody>
  </table>

  {{else}}
    <h3 class="ui message">
      Empty modpack
    </h3>

{{/if}}
